{
  "info": {
    "name": "API Peminjaman Buku Perpustakaan",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Loans",
      "item": [
        {
          "name": "Get all loans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ]
            }
          }
        },
        {
          "name": "Filter: Terlambat",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans?status=Terlambat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Terlambat"
                }
              ]
            }
          }
        },
        {
          "name": "Filter: Dipinjam",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans?status=Dipinjam",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Dipinjam"
                }
              ]
            }
          }
        },
        {
          "name": "Filter: Dikembalikan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans?status=Dikembalikan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Dikembalikan"
                }
              ]
            }
          }
        },
        {
          "name": "Filter: member + status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans?status=Terlambat&member_id=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Terlambat"
                },
                {
                  "key": "member_id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get loan by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "1"
              ]
            }
          }
        },
        {
          "name": "Create loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_id\": 1,\n  \"book_id\": 2,\n  \"due_date\": \"2026-10-20\",\n  \"notes\": \"Pinjam 1 minggu\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ]
            }
          }
        },
        {
          "name": "Return book (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Dikembalikan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "1"
              ]
            }
          }
        },
        {
          "name": "Delete loan",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "1"
              ]
            }
          }
        }
      ]
    },
